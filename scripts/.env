# ── Result PIN system — Paystack + PIN security ─────────────────────────────
# Required for online PIN purchase (see src/lib/paystack.server.ts). Without
# these, /result-pin/buy shows "online payment isn't configured yet" and
# admissions staff can still issue PINs manually from Admin → Result PINs.
# Get live/test keys from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
# Required always (not just for Paystack) — used to hash every Result PIN
# before it's stored (see src/lib/result-pin-crypto.server.ts). Generate a
# long random value once per environment and never change it after PINs
# have been issued, or every existing PIN will stop validating.
# e.g. openssl rand -hex 32
RESULT_PIN_HASH_PEPPER=""
